<?xml version="1.0"?>
<launch>

    <arg name="detector"                default="carla"         doc="carla (ground truth), cluster (lesson 5 nodes)" />
    <arg name="tfl_detector"            default="carla"         doc="carla (ground truth), yolo (lesson 7 node)" />
    <arg name="map_name"                default="tartu_demo" />
    <arg name="lanelet2_map_name"       default="$(arg map_name).osm" />
    <arg name="speed_limit"             default="40" />
    <arg name="enable_auto_stop_checker" default="true"         doc="enable auto stop checker" />
    <arg name="onnx_path"               default="$(find autoware_mini)/data/models/traffic_lights/yolov11_tfl.onnx" doc="yolo model path" />
    <arg name="carla_host"              default="localhost" />
    <arg name="carla_port"              default="2000" />
    <arg name="use_manual_control"      default="false" />
    <arg name="generate_traffic"        default="false"         doc="let Carla generate background traffic (scenarios provide their own)" />
    <arg name="use_rgb_view"            default="true"          doc="attach a third-person view camera to the ego for RViz" />

    <!-- Localization -->
    <group ns="localization">
        <node pkg="autoware_mini" type="carla_localizer.py" name="carla_localizer" output="screen" required="true" />

        <rosparam command="load" file="$(find autoware_mini_tutorial)/shared/config/localization.yaml" />
    </group>

    <!-- Detection -->
    <group ns="detection">
        <!-- Obstacle detection with the lesson 5 nodes -->
        <group if="$(eval detector=='cluster')">
            <group ns="lidar">
                <!-- Ground removal -->
                <group ns="center">
                    <node pkg="autoware_mini" type="naive_ground_removal.py" name="naive_ground_removal" output="screen" required="true">
                        <remap from="points_raw" to="/lidar_center/points_raw" />
                    </node>
                </group>
                <!-- Filtering -->
                <node pkg="nodelet" type="nodelet" name="pcl_manager" args="manager" output="screen" required="true" />
                <node pkg="nodelet" type="nodelet" name="voxel_grid_filter" args="load pcl/VoxelGrid pcl_manager" output="screen" required="true">
                    <remap from="~input" to="/detection/lidar/center/points_no_ground" />
                    <remap from="~output" to="/detection/lidar/points_filtered" />
                </node>
                <!-- Point clusterer -->
                <node pkg="autoware_mini_tutorial" type="points_clusterer.py" name="points_clusterer" output="screen" required="true" />

                <node pkg="autoware_mini_tutorial" type="cluster_detector.py" name="cluster_detector" output="screen" required="true" />

                <node pkg="topic_tools" type="relay" args="detected_objects /detection/detected_objects" name="detected_objects_relay" output="screen" required="true" />
            </group>

            <node pkg="autoware_mini" type="ema_tracker.py" name="ema_tracker" output="screen" required="true" />
            <node pkg="autoware_mini" type="detected_objects_visualizer.py" name="tracked_objects_visualizer" output="screen" required="true">
                <remap from="detected_objects" to="tracked_objects" />
                <remap from="detected_objects_markers" to="tracked_objects_markers" />
            </node>
            <node pkg="topic_tools" type="relay" args="tracked_objects final_objects" name="detected_objects_relay" output="screen" required="true" />
        </group>

        <!-- Obstacle detection from Carla's ground truth objects -->
        <group if="$(eval detector=='carla')">
            <!-- carla_detector reads its output frame from the autoware_mini perception namespace -->
            <param name="/perception/output_frame" value="map" />
            <node pkg="autoware_mini" type="carla_detector.py" name="carla_detector" output="screen" required="true" />
            <node pkg="topic_tools" type="relay" args="detected_objects final_objects" name="detected_objects_relay" output="screen" required="true" />
        </group>

        <node pkg="autoware_mini" type="detected_objects_visualizer.py" name="final_objects_visualizer" output="screen" required="true">
            <remap from="detected_objects" to="final_objects" />
            <remap from="detected_objects_markers" to="final_objects_markers" />
        </node>

        <!-- Traffic light detection with the lesson 7 node -->
        <group if="$(eval tfl_detector=='yolo')">
            <!-- Camera FL -->
            <node pkg="autoware_mini_tutorial" type="yolo_traffic_light_detector.py" name="yolo_traffic_light_detector" output="screen" required="true" ns="camera1">
                <remap from="camera_info" to="/camera_fl/camera_info"/>
                <remap from="image_raw" to="/camera_fl/image_raw"/>
                <param name="lanelet2_map_path" value="$(find autoware_mini)/data/maps/$(arg lanelet2_map_name)" />
                <param name="onnx_path" value="$(arg onnx_path)" />
            </node>

            <!-- Camera FR -->
            <node pkg="autoware_mini_tutorial" type="yolo_traffic_light_detector.py" name="yolo_traffic_light_detector" output="screen" required="true" ns="camera2">
                <remap from="camera_info" to="/camera_fr/camera_info"/>
                <remap from="image_raw" to="/camera_fr/image_raw"/>
                <param name="lanelet2_map_path" value="$(find autoware_mini)/data/maps/$(arg lanelet2_map_name)" />
                <param name="onnx_path" value="$(arg onnx_path)" />
            </node>

            <!-- Merge statuses from the two cameras -->
            <node pkg="autoware_mini" type="traffic_light_majority_merger.py" name="traffic_light_majority_merger" output="screen" required="true" />
        </group>

        <!-- Traffic light statuses from Carla's ground truth -->
        <node if="$(eval tfl_detector=='carla')" pkg="autoware_mini" type="carla_traffic_light_detector.py" name="carla_traffic_light_detector" output="screen" required="true">
            <param name="lanelet2_map_path" value="$(find autoware_mini)/data/maps/$(arg lanelet2_map_name)" />
            <param name="publish_rate" value="10" />
        </node>

        <rosparam command="load" file="$(find autoware_mini_tutorial)/shared/config/detection.yaml"/>
    </group>

    <!-- Planning -->
    <group ns="planning">

        <!-- Lanelet2 map visualizer -->
        <node pkg="autoware_mini" type="lanelet2_map_visualizer.py" name="lanelet2_map_visualizer" output="screen" required="true">
            <param name="lanelet2_map_path" value="$(find autoware_mini)/data/maps/$(arg lanelet2_map_name)" />
            <param name="enable_auto_stop_checker" value="$(arg enable_auto_stop_checker)" />
            <param name="enable_road_closures" value="false" />
        </node>

        <!-- Lanelet2 global planner -->
        <node pkg="autoware_mini_tutorial" type="lanelet2_global_planner.py" name="lanelet2_global_planner" output="screen" required="true">
            <param name="lanelet2_map_path" value="$(find autoware_mini)/data/maps/$(arg lanelet2_map_name)" />
            <param name="speed_limit"       value="$(arg speed_limit)" />
        </node>

        <!-- Global path visualizer -->
        <node pkg="autoware_mini" type="global_path_visualizer.py" name="global_path_visualizer" output="screen" required="true"/>

        <!-- Collision-points based local planner -->
        <group>
            <node pkg="autoware_mini_tutorial" type="local_path_extractor.py" name="local_path_extractor" output="screen" required="true" />

            <node pkg="autoware_mini_tutorial" type="simple_collision_checker.py" name="simple_collision_checker" output="screen" required="true">
                <param name="lanelet2_map_path" value="$(find autoware_mini)/data/maps/$(arg lanelet2_map_name)" />
            </node>

            <node pkg="autoware_mini_tutorial" type="simple_speed_planner.py" name="simple_speed_planner" output="screen" required="true" />
        </group>
        <!-- Local path visualizer -->
        <node pkg="autoware_mini" type="local_path_visualizer.py" name="local_path_visualizer" output="screen" required="true">
            <param name="use_swerving" value="false" />
            <remap from="local_path" to="visualized_path" />
        </node>

        <!-- Stop line status visualizer -->
        <node pkg="autoware_mini" type="stop_line_status_visualizer.py" name="stop_line_status_visualizer" output="screen" required="true">
            <param name="lanelet2_map_path" value="$(find autoware_mini)/data/maps/$(arg lanelet2_map_name)" />
            <remap from="stop_line_status" to="/detection/traffic_light_status" />
        </node>

        <!-- Config -->
        <rosparam command="load" file="$(find autoware_mini_tutorial)/shared/config/planning.yaml" />

    </group>

    <!-- Control -->
    <group ns="control">
        <!-- Follower -->
        <node pkg="autoware_mini_tutorial" type="pure_pursuit_follower.py" name="pure_pursuit_follower" output="screen" required="true">
            <remap from="path" to="/planning/local_path" />
        </node>
        <rosparam command="load" file="$(find autoware_mini_tutorial)/shared/config/control.yaml"/>
    </group>

    <!-- Load vehicle config data -->
    <rosparam command="load" file="$(find autoware_mini)/config/vehicle.yaml" ns="vehicle"/>

    <!-- Carla platform: bridge, ego spawn, sensors, static TFs -->
    <include file="$(find autoware_mini)/launch/platform/carla.launch">
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="use_lidar"           value="$(eval detector=='cluster')" />
        <arg name="use_mako_cameras"    value="$(eval tfl_detector=='yolo')" />
        <arg name="carla_host"          value="$(arg carla_host)" />
        <arg name="carla_port"          value="$(arg carla_port)" />
        <arg name="use_manual_control"  value="$(arg use_manual_control)" />
        <arg name="generate_traffic"    value="$(arg generate_traffic)" />
        <arg name="use_scenario_runner" value="true" />
    </include>

    <!-- Third-person view camera attached to the ego for the RViz simulation view
         (the autoware_mini sensor setups no longer include one).
         The delay lets the main spawner create the ego first - the sensors-only spawner
         reads the actor list once at startup and fails if the ego is not in it yet. -->
    <node if="$(arg use_rgb_view)" pkg="carla_spawn_objects" type="carla_spawn_objects.py" name="carla_rgb_view_spawner" output="screen" launch-prefix="bash -c 'sleep 15; exec &quot;$0&quot; &quot;$@&quot;'">
        <param name="objects_definition_file" value="$(find autoware_mini_tutorial)/lesson8/config/carla_rgb_view.json" />
        <param name="spawn_sensors_only" value="true" />
    </node>

    <group ns="lexus_model">
        <param name="robot_description" textfile="$(find autoware_mini)/config/urdf/lexus_model.urdf" />
        <node pkg="robot_state_publisher" type="robot_state_publisher" name="lexus_model_state_publisher" output="screen" required="true" />
    </group>

    <!-- Rviz -->
    <!-- Dashboard (the dashboard reads the visualization-only path topic) -->
    <group>
        <remap from="/planning/local_path" to="/planning/visualized_path" />
        <include file="$(find autoware_mini)/launch/dashboard.launch" />
    </group>
    <node type="rviz" name="rviz" pkg="rviz" args="-d $(find autoware_mini_tutorial)/lesson8/rviz/lesson8.rviz" required="true" />

</launch>
